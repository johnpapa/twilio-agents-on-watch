# Copy this file to .env and fill in real values.
# `.env` is gitignored -- never commit real credentials.
#
# Run with MOCK=1 (see `npm run practice`) to skip every value below entirely.

# ---- Model (Vercel AI SDK, Anthropic provider) ----
ANTHROPIC_API_KEY=
# Optional -- override the model id the agent runs on.
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Twilio ----
# Auth is API Key + Secret, NOT the account auth token. The auth token is a
# root credential for the whole account; an API key can be scoped and
# revoked without rotating everything else. Create one under
# Twilio Console -> Account -> API keys & tokens.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Texting runs over the Twilio WhatsApp Sandbox by default -- real messages,
# no A2P 10DLC registration, no multi-day wait. Optional: only set this if
# your Twilio Console's Sandbox page shows a different number than the
# standard shared one (+14155238886).
TWILIO_WHATSAPP_NUMBER=

# A voice-capable Twilio number, E.164 format (e.g. +15551234567). Used as
# the `from` on outbound calls. Buy one under Console -> Phone Numbers.
TWILIO_VOICE_NUMBER=

# The presenter's own phone, E.164 format. This is who gets texted/called
# during the live escalation. Before running for real, text
# "join <your-sandbox-code>" (shown on the Console's WhatsApp Sandbox page)
# to the sandbox number from this phone -- the join expires after 72 hours.
PRESENTER_PHONE_NUMBER=

# ---- Server ----
PORT=4000
